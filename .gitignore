# Local training-mode revert/backup artifacts (not repo content)
.training-mode-checkpoint/

# Training Mode canonical cache (regenerated on demand)
training_cache/

# Detector-loop ledger (test output, regenerated per run)
tests/detector_ledger.json

# Tranco long-tail domain corpus cache (fetched at startup, see modules/domain_corpus.py)
domain_cache/

# Local validation harnesses (not part of the shipped simulator)
#
# Every test and validation script lives in _local_validation/ and stays local: none of
# it is tracked (the 15 committed before this entry existed were untracked on
# 2026-10-21). git ignores UNTRACKED paths only, so if a script is ever force-added
# (git add -f), take it back out with:
#     git rm --cached _local_validation/<name>.py
_local_validation/

# Persistent simulator state (beacon destinations etc.); delete to reset
state/
