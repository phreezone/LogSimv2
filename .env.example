# ── Dashboard / control API auth ───────────────────────────────────────────────────────────────
# ZERO-CONFIG: leave blank and the dashboard behaves exactly as before — all routes open,
# no login. Set a token to gate the control API (/api/* and /api/v1/*) for external apps and
# the MCP server. The browser UI still needs NO login: it receives the token at page load and
# attaches it automatically. External callers send it as `X-API-Key: <token>` or
# `Authorization: Bearer <token>`. Strongly recommended whenever DASHBOARD_HOST is not localhost.
LOGSIM_API_KEY=

# ── Syslog destination (Cisco ASA, Firepower, Checkpoint, Fortinet, HTTPD, Zscaler, Infoblox) ──
SYSLOG_HOST=<your-xsiam-syslog-collector-ip>

# ── XSIAM HTTP Event Collector (all HTTP-transport modules) ───────────────────────────────────
HTTP_COLLECTOR_URL=https://api-<your-tenant>.xdr.us.paloaltonetworks.com/logs/v1/event

# ── Okta SSO ─────────────────────────────────────────────────────────────────────────────────
# URL and Auth type are not needed of the HTTP_Collector_URL is defined above
# OKTA_COLLECTOR_URL=
# OKTA_AUTH_TYPE=
OKTA_KEY=

# ── Windows Event Log ────────────────────────────────────────────────────────────────────────
# For WEC transport (Direct WS-Management to Broker VM):
#   Set transport to "wec" in config.json windows_events_config.
#   Requires a PFX client cert from the XSIAM console.
#   Cross-platform — works on Windows, Linux, Mac.
#
#   From the XSIAM console WEC configuration page, copy the Subscription
#   Manager URL. It looks like:
#     Server=HTTPS://<host>:5986/wsman/SubscriptionManager/WEC,Refresh=600,IssuerCA=<thumbprint>
#   Extract the base URL (everything before /SubscriptionManager):
WEC_BROKER_URL=https://<your-broker-vm-hostname>:5986/wsman
WEC_PFX_PATH=/path/to/broker-vm-cert.pfx
WEC_PFX_PASSWORD=
WEC_ISSUER_CA=

# ── Proofpoint Email ─────────────────────────────────────────────────────────────────────────
# URL and Auth type are not needed of the HTTP_Collector_URL is defined above
# PROOFPOINT_COLLECTOR_URL=
# PROOFPOINT_AUTH_TYPE=
PROOFPOINT_KEY=

# ── AWS GuardDuty ────────────────────────────────────────────────────────────────────────────
# S3 transport (default): findings write to <bucket>/AWSLogs/<account>/GuardDuty/<region>/<UUID>.jsonl.gz,
# matching GuardDuty's native export. Configure an XSIAM S3 data source with the GuardDuty log type
# on that prefix (-> aws_guardduty_raw). Optional: land in a DEDICATED bucket; if unset, findings use
# the shared S3_BUCKET_NAME (same bucket as CloudTrail, GuardDuty/ prefix).
GUARDDUTY_S3_BUCKET_NAME=
# Optional HTTP fallback (only if aws_guardduty_config.transport is set to "http"):
GUARDDUTY_COLLECTOR_URL=
GUARDDUTY_AUTH_TYPE=
GUARDDUTY_KEY=

# ── Google Workspace collectors ────WORK IN PROGRESS──────────────────────────────────────────
# GOOGLE_LOGIN_COLLECTOR_URL=
# GOOGLE_AUTH_TYPE=
# GOOGLE_LOGIN_KEY=
# GOOGLE_ADMIN_KEY=
# GOOGLE_DRIVE_KEY=
# GOOGLE_USER_ACCOUNTS_KEY=
# GOOGLE_TOKEN_KEY=

# ── AWS CloudTrail (S3 transport) ─────────────────────────────────────────────────────────────
s3_bucket_name=
aws_account_id=
aws_region=us-east-1
aws_access_key_id=
aws_secret_access_key=

# ── GCP Cloud Audit Logs (Pub/Sub transport) ──────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_PUBSUB_TOPIC=
# Option A: path to a service account JSON key file mounted into the container
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json
# Option B: inline service account JSON (single line, no newlines)
GCP_SERVICE_ACCOUNT_KEY_JSON=

# ── XDR attack orchestration (purple-team: real Atomic techniques + synthetic net) ─────────────
# Triggers REAL Atomic Red Team techniques on a live Windows box running the Cortex
# XDR agent (over WinRM) while LogSim emits synthetic network logs pinned to that
# box's real identity. THIS is the only place the target is configured — config.json
# holds no host/creds/IPs, so you never edit config.json for a new box.
#
# Required for a live box:
XDR_TARGET_HOST=<lab-box-ip-or-hostname>
XDR_TARGET_WINRM_USER=<local-admin-username>          # no DOMAIN\ prefix for a workgroup box
XDR_TARGET_WINRM_PASSWORD=<local-admin-password>
#
# Optional (defaults shown) — omit unless you need to change them:
# XDR_TARGET_WINRM_PORT=5985
# XDR_TARGET_WINRM_SCHEME=http                          # http (5985) or https (5986)
# XDR_TARGET_WINRM_AUTH=ntlm                            # ntlm | basic | kerberos
# XDR_TARGET_TRANSPORT=winrm                            # set to "stub" for no-box dev (uses config.json stub_identity)
# XDR_TARGET_EGRESS_IP=<org-nat-public-ip>             # IP external-facing logs (Zscaler/perimeter FW) should carry
# XDR_EMAIL_DOMAIN=<corp.example>                       # derive user email when discovery can't
#
# XSIAM Public API (only needed for agent alert<->block policy control + read-back):
# XSIAM_API_BASE=https://api-<your-tenant>.xdr.us.paloaltonetworks.com
# XSIAM_API_KEY_ID=<numeric-key-id>
# XSIAM_API_KEY=<api-key-secret>
