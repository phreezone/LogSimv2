# Copy to `.env` in the project root and fill in only the sections for the modules you run.
# Variable names are UPPERCASE: Linux and Docker environments are case-sensitive, so a
# lowercase name that happens to work on Windows will be ignored there.

# ── Dashboard / control API auth ───────────────────────────────────────────────────────────────
# ZERO-CONFIG: leave blank and the dashboard behaves exactly as before — all routes open,
# no login. Set a token to gate the control API (/api/* and /api/v1/*) for external apps and
# the MCP server. The browser UI still needs NO login: it receives the token at page load and
# attaches it automatically. External callers send it as `X-API-Key: <token>` or
# `Authorization: Bearer <token>`. Strongly recommended whenever DASHBOARD_HOST is not localhost.
LOGSIM_API_KEY=

# Where the dashboard listens (defaults shown).
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=5000

# MCP server (integrations/mcp_server.py): base URL of the running dashboard.
# LOGSIM_API_URL=http://127.0.0.1:5000

# ── Syslog destination (Cisco ASA, Firepower, Checkpoint, Fortinet, HTTPD, Zscaler, Infoblox) ──
SYSLOG_HOST=<your-xsiam-syslog-collector-ip>

# ── XSIAM HTTP Event Collector (all HTTP-transport modules) ───────────────────────────────────
HTTP_COLLECTOR_URL=https://api-<your-tenant>.xdr.us.paloaltonetworks.com/logs/v1/event

# ── Okta SSO ─────────────────────────────────────────────────────────────────────────────────
# URL and auth type are not needed if HTTP_COLLECTOR_URL is defined above
# OKTA_COLLECTOR_URL=
# OKTA_AUTH_TYPE=
OKTA_KEY=

# ── Proofpoint Email ─────────────────────────────────────────────────────────────────────────
# URL and auth type are not needed if HTTP_COLLECTOR_URL is defined above
# PROOFPOINT_COLLECTOR_URL=
# PROOFPOINT_AUTH_TYPE=
PROOFPOINT_KEY=

# ── Microsoft Entra ID / Office 365 (Cribl transport) ────────────────────────────────────────
# The seven Microsoft modules (Azure AD sign-ins, Azure AD audit, O365 Azure AD, Exchange
# Online, SharePoint Online, DLP, General) push into XSIAM's integrated Cribl receiver.
# NO Cribl Stream instance and NO Microsoft tenant are needed — only XSIAM's free Cribl
# integration:  Settings -> Data Sources -> add "Cribl" -> generate token, and copy its API URL.
# Install the Microsoft content packs (Office 365 / Azure AD) in the tenant as well, or the
# data lands but is not modeled into XDM.
#
#   CRIBL_COLLECTOR_URL  the integration's API URL, ending in /logs/v1/integrated/cribl/data
#   CRIBL_TOKEN          the token generated with it (LogSim adds the "Bearer " prefix itself)
CRIBL_COLLECTOR_URL=https://api-<your-tenant>.xdr.us.paloaltonetworks.com/logs/v1/integrated/cribl/data
CRIBL_TOKEN=

# Optional: identity map exported from Cloud Identity Engine, so Entra/O365 users resolve
# as directory identities (ITDR enrichment). Default: state/cie_identity_map.json if present.
# LOGSIM_CIE_IDENTITY_MAP=/path/to/cie_identity_map.json

# ── Windows Event Log ────────────────────────────────────────────────────────────────────────
# For WEC transport (Direct WS-Management to Broker VM):
#   Set transport to "wec" in config.json windows_events_config (the default).
#   Requires a PFX client cert from the XSIAM console.
#   Cross-platform — works on Windows, Linux, Mac.
#
#   From the XSIAM console WEC configuration page, copy the Subscription
#   Manager URL. It looks like:
#     Server=HTTPS://<host>:5986/wsman/SubscriptionManager/WEC,Refresh=600,IssuerCA=<thumbprint>
#   Extract the base URL (everything before /SubscriptionManager):
WEC_BROKER_URL=https://<your-broker-vm-hostname>:5986/wsman
WEC_PFX_PATH=/path/to/broker-vm-cert.pfx
WEC_PFX_PASSWORD=
# The IssuerCA thumbprint from the same URL. Informational only — LogSim does not read it.
# WEC_ISSUER_CA=
#
# Alternative: transport "http" in windows_events_config sends to an HTTP collector instead.
# WINDOWS_EVENTS_COLLECTOR_URL=
# WINDOWS_EVENTS_KEY=

# ── AWS CloudTrail (S3 transport) ─────────────────────────────────────────────────────────────
# Values come from the CloudFormation stack outputs (docs/configuration.md).
# AWS_ACCOUNT_ID is also substituted for PLACEHOLDER_AWS_ACCOUNT_ID throughout config.json.
S3_BUCKET_NAME=
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── GCP Cloud Audit Logs (Pub/Sub transport) ──────────────────────────────────────────────────
# GCP_PROJECT_ID / GCP_PROJECT_NUMBER are also substituted for the PLACEHOLDER_GCP_* values
# throughout config.json (service-account emails, resource paths).
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_PUBSUB_TOPIC=
# Option A: path to a service account JSON key file mounted into the container
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-key.json
# Option B: inline service account JSON (single line, no newlines)
GCP_SERVICE_ACCOUNT_KEY_JSON=

# ── Send pipeline tuning (optional; defaults shown) ──────────────────────────────────────────
# Generation and delivery are decoupled by bounded send queues drained by worker threads.
# S3 / WEC / Pub/Sub share the default lane; the HTTP collector, the Cribl receiver and
# syslog each have their own lane and send in BATCHES (many events per request / TCP write).
# SEND_WORKERS=8                 # sender threads on the default lane
# SEND_QUEUE_SIZE=5000           # events buffered per lane between generation and delivery
# SEND_ENQUEUE_MAX_WAIT_S=30     # how long a generator waits for room before shedding load
# BATCH_SEND_WORKERS=4           # sender threads per batched lane (HTTP, Cribl, syslog)
# BATCH_LINGER_MS=100            # how long a batch waits to fill before it is sent
# HTTP_BATCH_MAX_EVENTS=1000     # events per request (HTTP collector / Cribl receiver) or syslog batch
# HTTP_BATCH_MAX_BYTES=1048576   # bytes per request; the collector accepts up to 10 MiB, 1 MiB is recommended
# SYSLOG_BATCH_MAX_BYTES=262144  # bytes per syslog TCP write (whole newline-framed lines, never split)
# HTTP_POOL_SIZE=32              # pooled HTTP connections (raise for very high sender counts)

# ── XDR attack orchestration (purple-team: real Atomic techniques + synthetic net) ─────────────
# Triggers REAL Atomic Red Team techniques on a live Windows box running the Cortex
# XDR agent (over WinRM) while LogSim emits synthetic network logs pinned to that
# box's real identity. THIS is the only place the target is configured — config.json
# holds no host/creds/IPs, so you never edit config.json for a new box.
#
# Required for a live box:
XDR_TARGET_HOST=<lab-box-ip-or-hostname>
XDR_TARGET_WINRM_USER=<local-admin-username>          # no DOMAIN\ prefix for a workgroup box
XDR_TARGET_WINRM_PASSWORD=<local-admin-password>
#
# Optional (defaults shown) — omit unless you need to change them:
# XDR_TARGET_WINRM_PORT=5985
# XDR_TARGET_WINRM_SCHEME=http                          # http (5985) or https (5986)
# XDR_TARGET_WINRM_AUTH=ntlm                            # ntlm | basic | kerberos
# XDR_TARGET_TRANSPORT=winrm                            # set to "stub" for no-box dev (uses config.json stub_identity)
# XDR_TARGET_EGRESS_IP=<org-nat-public-ip>             # IP external-facing logs (Zscaler/perimeter FW) should carry
# XDR_EMAIL_DOMAIN=<corp.example>                       # derive user email when discovery can't
#
# ── XSIAM Public API ──────────────────────────────────────────────────────────────────────────
# Needed for XDR orchestration policy control + read-back, and by the validation scripts in
# _local_validation/ (threat harness, probes) to query datasets and alerts.
# XSIAM_API_BASE=https://api-<your-tenant>.xdr.us.paloaltonetworks.com
# XSIAM_API_KEY_ID=<numeric-key-id>
# XSIAM_API_KEY=<api-key-secret>
# Real (non-LogSim) hosts that also feed microsoft_windows_raw, e.g. a lab DC on a live WEC
# subscription; validation tooling treats their events as foreign. Comma-separated.
# XSIAM_FOREIGN_HOSTS=dc1.yourlab.local,yourlabhost
